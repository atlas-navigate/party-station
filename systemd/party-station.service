[Unit]
Description=Party Station game server
# network.target, not network-online.target: the server binds 0.0.0.0 and
# needs no address yet, and waiting for DHCP/Wi-Fi held the TV kiosk back
# 10-30s on every boot.
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/env node server/index.js
Environment=PORT=80
Environment=NODE_ENV=production
# Lets node bind port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Neither NoNewPrivileges nor a CapabilityBoundingSet here, and both omissions
# are deliberate: switching Wi-Fi and capping the display mode need root, which
# this service reaches through sudo. NoNewPrivileges blocks sudo's setuid exec
# outright, and a bounding set of just CAP_NET_BIND_SERVICE is subtler — sudo
# execs fine but can never acquire CAP_SETUID, so every call fails with a
# permission error that looks like a broken sudoers rule.
#
# The privilege is kept narrow by construction instead:
# /etc/sudoers.d/party-station grants exactly one root-owned binary,
# /usr/local/sbin/party-station-ctl (scripts/psctl), which accepts a fixed set
# of subcommands. It lives outside the app directory on purpose — the app user
# and the self-updater's `git reset --hard` can both rewrite anything under
# __APP_DIR__, so a sudoers rule pointing there would be root-equivalent.
Restart=always
RestartSec=2
# The self-updater exits(0) after a successful git pull; Restart=always
# brings the server back up on the new code.

[Install]
WantedBy=multi-user.target
